{
    // Place your snippets for python here. Each snippet is defined under a snippet name and has a prefix, body and 
    // description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
    // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
    // same ids are connected.
    // Example:
    // "Print to console": {
    // 	"prefix": "log",
    // 	"body": [
    // 		"console.log('$1');",
    // 		"$2"
    // 	],
    // 	"description": "Log output to console"
    // }
    "__name__ is __main__": {
        "prefix": "if __name__ == \"__main__\"",
        "body": [
            "if __name__ == \"__main__\":",
            "    pass$0"
        ]
    },
    "name is main": {
        "prefix": "name is main",
        "body": [
            "if __name__ == \"__main__\":",
            "    pass$0"
        ]
    },
    "class": {
        "prefix": "class",
        "body": [
            "class $1($2):",
            "    pass$0"
        ]
    },
    "function": {
        "prefix": "def",
        "body": [
            "def $1($2) -> $3:",
            "    pass$0"
        ]
    },
    "method": {
        "prefix": "def ",
        "body": [
            "def $1(self, $2) -> $3:",
            "    return$0"
        ]
    },
    "data class": {
        "prefix": "@dataclass",
        "body": [
            "@dataclass",
            "class $1:",
            "    $0"
        ]
    },
    "dataclass": {
        "prefix": "dataclass",
        "body": [
            "@dataclass",
            "class $1:",
            "    $0"
        ]
    },
    "abstract class": {
        "prefix": "abstract",
        "body": [
            "class $1(ABC):",
            "    pass$0"
        ]
    },
    "abstract method": {
        "prefix": "abstractmethod",
        "body": [
            "@abstractmethod",
            "def $1(self, $2) -> $3:",
            "    pass$0"
        ]
    },
    "interface": {
        "prefix": "interface",
        "body": [
            "class $1(ABC):",
            "    pass$0"
        ]
    },
    "protocol": {
        "prefix": "protocol",
        "body": [
            "class $1(Protocol):",
            "    def $2(self, $3) -> $4: ...$0"
        ]
    },
    "type: dictionary": {
        "prefix": "dict",
        "body": [
            "dict[$1, $2]$0",
        ]
    },
    "type: list": {
        "prefix": "list",
        "body": [
            "list[$1]$0",
        ]
    },
    "dictionary": {
        "prefix": "dictionary",
        "body": [
            "{ $1 : $2 }$0",
        ]
    }
}