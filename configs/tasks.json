{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Projects: View Projects",
            "detail": "Focus on the projects view.",
            "group": "none",
            "type": "shell",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "echo 'Executing...'",
            "args": [
                "${command:projectsExplorerFavorites.focus}"
            ],
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "echo": false,
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true,
                "close": true
            }
        },
        {
            "label": "Scaffold VSC Project",
            "detail": "Create new vscode project (workspace).",
            "group": "none",
            "hide": true,
            "type": "shell",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "python",
            "args": [
                "/me/dev/omcmathe/vsconfig/create_project.py",
            ],
            "presentation": {
                "echo": false,
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true,
                "close": true
            }
        },
        {
            "label": "Projects: New Project",
            "detail": "Create new vscode project (workspace).",
            "group": "none",
            "type": "shell",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "codium",
            "args": [
                "-r",
                "${workspaceFolder}/.vscode/${workspaceFolderBasename}.code-workspace"
            ],
            "dependsOn": [
                "Scaffold VSC Project"
            ],
            "presentation": {
                "echo": false,
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true,
                "close": true
            }
        }
    ]
}