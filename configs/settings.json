{
    "[markdown]": {
        "editor.fontFamily": "'Google Sans', 'Google Sans', monospace",
        "editor.fontSize": 18
    },
    "[python]": {
        "editor.renderWhitespace": "boundary"
    },
    /* BREADCRUMBS */
    "breadcrumbs.enabled": false,
    //
    /* EDITOR */
    "editor.autoIndent": "advanced",
    "editor.detectIndentation": false,
    "editor.fontFamily": "'Google Sans Code', 'Google Sans Code', monospace",
    "editor.fontSize": 16,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.indentSize": "tabSize",
    "editor.inlayHints.enabled": "off",
    "editor.lineNumbers": "interval",
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "selection",
    "editor.semanticHighlighting.enabled": true,
    "editor.tabCompletion": "onlySnippets",
    "editor.tabSize": 4,
    "editor.useTabStops": true,
    //
    /* FILE EXPLORER */
    "explorer.autoOpenDroppedFile": false,
    "explorer.autoReveal": true,
    "explorer.compactFolders": false,
    //
    /* PROJECT MANAGER */
    "projectManager.git.baseFolders": [
        "/me/"
    ],
    "projectManager.git.maxDepthRecursion": 0,
    //
    /* PYTHON EXTENSION */
    "python.languageServer": "Default",
    //
    /* TERMINAL */
    "terminal.integrated.allowChords": false,
    "terminal.integrated.allowMnemonics": true,
    "terminal.integrated.confirmOnKill": "always",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorStyleInactive": "line",
    "terminal.integrated.cursorWidth": 2,
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.defaultProfile.windows": "pwsh",
    "terminal.integrated.enableVisualBell": true,
    "terminal.integrated.environmentChangesIndicator": "on",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.hideOnStartup": "whenEmpty",
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.showExitAlert": false,
    //
    /* APPLICATION WINDOW */
    "window.autoDetectColorScheme": true,
    "window.commandCenter": true,
    "window.customMenuBarAltFocus": false,
    "window.enableMenuBarMnemonics": false,
    "window.menuBarVisibility": "hidden",
    "window.newWindowProfile": "Default",
    "window.openFoldersInNewWindow": "on",
    "window.zoomLevel": 1.25,
    //
    /* WORKBENCH */
    "workbench.activityBar.location": "bottom",
    "workbench.colorTheme": "Dominvm Grey Dark",
    "workbench.iconTheme": "flow-deep",
    "workbench.navigationControl.enabled": false,
    "workbench.panel.showLabels": false,
    "workbench.preferredDarkColorTheme": "Dominvm Baby Blue Dark Solarized",
    "workbench.preferredLightColorTheme": "Dominvm Blue Light",
    "workbench.productIconTheme": "Tabler",
    "workbench.startupEditor": "terminal",
    //
    /* ZEN MODE */
    "zenMode.fullScreen": false,
    "zenMode.showTabs": "single"
    //
}